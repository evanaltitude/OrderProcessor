{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "batchSize": 16,
      "newBatchThreshold": 8,
      "visibilityTimeout": "00:05:00",
      "maxPollingInterval": "00:01:00",
      "maxDequeueCount": 5
    },
    "durableTask": {
      "hubName": "OrderProcessorLocal"
    }
  }
}
