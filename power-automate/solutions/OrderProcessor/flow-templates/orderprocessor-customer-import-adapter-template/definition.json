                                                                                                          "inputs":  {
                                                                                                                         "method":  "POST",
                                                                                                                         "uri":  "@{concat(parameters(\u0027OrderProcessorApiBaseUrl\u0027), \u0027/imports/customers\u0027)}",
                                                                                                                         "headers":  {
